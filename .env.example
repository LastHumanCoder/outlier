# Instagram scraping. Without it the pipeline runs against fixtures/.
APIFY_TOKEN=

# Transcripts. Without it teardowns run on frames + caption only.
VIDEODB_API_KEY=

# The vision model, as provider:model. Set the matching key below.
OUTLIER_MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=
